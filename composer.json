{
    "name": "phpsoftbox/mongo",
    "description": "MongoDB connection manager component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-mongodb": "^2.4",
        "mongodb/mongodb": "^2.4.1",
        "phpsoftbox/collection": "^1.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/cli-app": "Required for mongo:migrate, mongo:migrate:rollback and mongo:migrate:make commands (MongoCommandProvider)."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\MongoDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\MongoDb\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\MongoDb\\Cli\\MongoCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
